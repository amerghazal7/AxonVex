/**
 * @file version.hpp
 * @brief AxonVex version constants.
 *
 * Generated by CMake from version.hpp.in — do not edit the generated file.
 * The single source of truth is the `project(... VERSION ...)` call in the
 * root CMakeLists.txt; every other version string (README, printWelcome(),
 * the conan recipe) should read from here instead of hardcoding a copy that
 * can drift.
 */
#pragma once

#define AXONVEX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define AXONVEX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define AXONVEX_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define AXONVEX_VERSION_STRING "@PROJECT_VERSION@"

namespace axonvex {
namespace core {

// Namespace-scope constexpr gives each TU its own (internal-linkage, C++14
// rule) copy — no ODR concern, no cross-TU symbol to export.
constexpr int kVersionMajor = AXONVEX_VERSION_MAJOR;
constexpr int kVersionMinor = AXONVEX_VERSION_MINOR;
constexpr int kVersionPatch = AXONVEX_VERSION_PATCH;
constexpr const char* kVersionString = AXONVEX_VERSION_STRING;

} // namespace core
} // namespace axonvex
