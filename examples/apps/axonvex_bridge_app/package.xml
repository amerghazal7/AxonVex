<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>axonvex_bridge_app</name>
  <version>0.1.0</version>
  <description>
    Sample AxonVex application that bridges ROS 2 topics into an AxonVex
    processing pipeline. Demonstrates how the adapter layer feeds data
    into ProcessingUnits managed by an AxonVexSystem.
  </description>
  <maintainer email="info@amerghazal.me">AxonVex Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
